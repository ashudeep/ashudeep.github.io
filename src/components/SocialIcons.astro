---
import { siteConfig } from '../data/site';
---

<div class="flex items-center gap-4 text-xl text-gray-500 dark:text-gray-400">
  <a
    href={`mailto:${siteConfig.email}`}
    class="hover:text-theme-light dark:hover:text-theme-dark transition-colors"
    aria-label="Email"
  >
    <i class="fas fa-envelope" aria-hidden="true"></i>
  </a>
  <a
    href={`https://scholar.google.com/citations?user=${siteConfig.social.scholar}`}
    target="_blank"
    rel="noopener"
    class="hover:text-theme-light dark:hover:text-theme-dark transition-colors"
    aria-label="Google Scholar"
  >
    <i class="ai ai-google-scholar" aria-hidden="true"></i>
  </a>
  <a
    href={`https://github.com/${siteConfig.social.github}`}
    target="_blank"
    rel="noopener"
    class="hover:text-theme-light dark:hover:text-theme-dark transition-colors"
    aria-label="GitHub"
  >
    <i class="fab fa-github" aria-hidden="true"></i>
  </a>
  <a
    href={`https://linkedin.com/in/${siteConfig.social.linkedin}`}
    target="_blank"
    rel="noopener"
    class="hover:text-theme-light dark:hover:text-theme-dark transition-colors"
    aria-label="LinkedIn"
  >
    <i class="fab fa-linkedin" aria-hidden="true"></i>
  </a>
  <a
    href={`https://x.com/${siteConfig.social.twitter}`}
    target="_blank"
    rel="noopener"
    class="hover:text-theme-light dark:hover:text-theme-dark transition-colors"
    aria-label="X (Twitter)"
  >
    <i class="fab fa-x-twitter" aria-hidden="true"></i>
  </a>
</div>
